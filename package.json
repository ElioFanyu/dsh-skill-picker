{
  "name": "@local/dsh-skill-picker",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "技能选择器：在输入框工具栏以列表方式浏览、搜索并点选技能，自动插入 /技能名，无需手打斜杠命令",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.2": "compatible"
      }
    },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "license": "MIT",
  "author": "ElioFanyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElioFanyu/dsh-skill-picker.git"
  },
  "homepage": "https://github.com/ElioFanyu/dsh-skill-picker#readme",
  "bugs": {
    "url": "https://github.com/ElioFanyu/dsh-skill-picker/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "skills",
    "picker",
    "composer"
  ]
}
